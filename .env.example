# Bitrix24 MCP Server — environment configuration
# Copy this file to .env and fill in your values

# Required: Bitrix24 incoming webhook URL
# Create at: Bitrix24 → Applications → Webhooks → Add inbound webhook
# Required permissions: crm, imbot, user
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your-webhook-token/

# Optional: bot token for chat bot operations
# Only needed if using the built-in chat bot tools
# BITRIX24_BOT_TOKEN=your-bot-token-here

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
