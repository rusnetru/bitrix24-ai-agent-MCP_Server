# ======================= Битрикс24 (коробка) =======================
# Входящий вебхук: Приложения → Разработчикам → Другое → Входящий вебхук.
# Права: crm, task, user, im, imbot. Создавайте от пользователя-администратора
# (агент видит и меняет данные с правами этого пользователя).
BITRIX_WEBHOOK_URL=https://portal.company.ru/rest/1/xxxxxxxxxxxxxxxx/
# Самоподписанный сертификат портала: false или путь к корневому CA (.pem)
BITRIX_VERIFY_SSL=true
# Внешний адрес портала для ссылок (по умолчанию берётся из вебхука)
# BITRIX_PORTAL_URL=https://portal.company.ru

# ======================= LLM через LiteLLM =======================
# OpenAI-совместимый адрес LiteLLM proxy (с /v1 или без — как у вас настроено)
LLM_BASE_URL=http://litellm.company.local:4000/v1
LLM_API_KEY=sk-...
# Имя модели так, как оно задано в LiteLLM (model_name в config.yaml)
LLM_MODEL=qwen
# auto — нативные tool calls, при отказе прокси переключиться на JSON-протокол;
# native — только нативные; json — всегда JSON-протокол (если vLLM запущен без --tool-call-parser)
LLM_TOOL_MODE=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=180
LLM_VERIFY_SSL=true
# Доп. параметры тела запроса (JSON). Для Qwen3 отключить «размышления»:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# ======================= Чат-бот =======================
BOT_CODE=b24_ai_agent
BOT_NAME=ИИ-агент
BOT_WORK_POSITION=ИИ-помощник по CRM и задачам
# Произвольная строка-идентификатор бота для режима вебхука (не меняйте после setup)
BOT_CLIENT_ID=b24_ai_agent_client_change_me
BOT_OPENLINE=false

# ======================= Приём событий =======================
# Адрес ЭТОГО сервиса, доступный с сервера Битрикс24 (внутренняя сеть подходит)
PUBLIC_URL=http://10.0.0.15:8090
# Секрет в URL обработчика (защита от посторонних запросов)
EVENT_SECRET=change-me-long-random-string
HTTP_HOST=0.0.0.0
HTTP_PORT=8090

# ======================= Поведение агента =======================
# false — режим только чтения
AGENT_ALLOW_WRITE=true
# ID пользователей через запятую, которым разрешено общаться с агентом (пусто — всем)
AGENT_ALLOWED_USERS=
AGENT_HISTORY=20
AGENT_MAX_STEPS=10
# Файл с дополнительными инструкциями (регламенты, тон, кодовые слова воронок)
# AGENT_PROMPT_FILE=prompt.md
# watched — отвечать на упоминание бота в любом таймлайне + на все комментарии отслеживаемых объектов
# mention — только на упоминание
TIMELINE_REPLY_MODE=watched
# >0 — опрашивать таймлайны отслеживаемых объектов (сек), если события не доставляются
TIMELINE_POLL_INTERVAL=0

DATA_DIR=data
LOG_LEVEL=INFO
