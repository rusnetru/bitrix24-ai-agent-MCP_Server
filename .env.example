# ======================= Битрикс24 (коробка) =======================
# Входящий вебхук: Разработчикам → Готовые сценарии → Другое → Входящий вебхук.
# Создавайте от СЕРВИСНОГО пользователя «ИИ-агент»: агент видит и меняет данные с его правами,
# комментарии в таймлайне и задачи будут от его имени.
# Права (scope): crm, task, user, imbot, im, department, sonet_group, calendar, bizproc, lists
BITRIX_WEBHOOK_URL=https://portal.company.ru/rest/15/xxxxxxxxxxxxxxxx/
# Самоподписанный сертификат портала: путь к корневому CA (.pem) или false (не рекомендуется)
BITRIX_VERIFY_SSL=true
# Адрес портала для ссылок в ответах (по умолчанию берётся из вебхука)
# BITRIX_PORTAL_URL=https://portal.company.ru
BITRIX_TIMEOUT=60

# ======================= LLM через LiteLLM =======================
# OpenAI-совместимый адрес LiteLLM proxy (с /v1 или без — как у вас настроено)
LLM_BASE_URL=http://litellm.company.local:4000/v1
LLM_API_KEY=sk-...
# Имя модели так, как оно задано в LiteLLM (model_name в config.yaml)
LLM_MODEL=qwen
# auto — нативные tool calls, при отказе прокси — JSON-протокол;
# native — только нативные; json — всегда JSON-протокол (если vLLM запущен без --tool-call-parser)
LLM_TOOL_MODE=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=180
LLM_VERIFY_SSL=true
# Доп. параметры тела запроса (JSON). Для Qwen3 отключить «размышления»:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# ======================= Чат-бот =======================
# v2 — imbot.v2 (рекомендуется), v1 — устаревший imbot.* (только push, нужен PUBLIC_URL)
BOT_API=v2
# fetch — агент сам забирает события (закрытый контур, входящий доступ не нужен)
# webhook — портал присылает события на PUBLIC_URL
BOT_EVENT_MODE=fetch
BOT_POLL_INTERVAL=3
# bot — личка, @упоминания и ответы боту; supervisor — все сообщения в чатах, где он состоит
BOT_TYPE=bot
BOT_CODE=b24_ai_agent
BOT_NAME=ИИ-агент
BOT_WORK_POSITION=ИИ-помощник по CRM и задачам
# Секрет бота imbot.v2 (до 40 символов). Пусто — сгенерируется и сохранится в DATA_DIR.
# BOT_TOKEN=
# Только для BOT_API=v1: идентификатор бота в режиме вебхука (не меняйте после setup)
# BOT_CLIENT_ID=b24_ai_agent_client
BOT_OPENLINE=false

# ======================= Push-приём событий (не нужен в режиме fetch) =======================
# Адрес ЭТОГО сервиса, доступный с сервера Битрикс24
# PUBLIC_URL=http://10.0.0.15:8090
EVENT_SECRET=change-me-long-random-string
HTTP_HOST=0.0.0.0
HTTP_PORT=8090

# ======================= Таймлайн CRM =======================
# Сканировать недавно активные элементы этих типов и отвечать на @упоминания (закрытый контур)
# Значения: deal, lead, contact, company, entityTypeId смарт-процесса или его название
TIMELINE_SCAN_TYPES=
TIMELINE_SCAN_INTERVAL=60
# >0 — опрашивать объекты, поставленные на отслеживание («следи за таймлайном сделки 123»), сек
TIMELINE_POLL_INTERVAL=30
# watched — упоминание + все комментарии отслеживаемых объектов; mention — только упоминание
TIMELINE_REPLY_MODE=watched
# Кроме бота и пользователя вебхука — чьи упоминания тоже адресованы агенту (ID через запятую)
TIMELINE_MENTION_IDS=

# ======================= Письма и файлы =======================
# Максимальный размер файла для чтения, МБ; сколько символов файла отдавать модели за раз
FILES_MAX_MB=25
FILE_READ_CHARS=12000
# Автопомощь: по новым входящим письмам/файлам у элементов этих типов готовить справку (пусто — выключено)
AUTO_ASSIST_TYPES=
# email — входящие письма, file — файлы в комментариях таймлайна
AUTO_ASSIST_ON=email,file
# timeline — комментарий в таймлайне, chat — личное сообщение ответственному от бота
AUTO_ASSIST_TARGET=timeline
AUTO_ASSIST_INTERVAL=120
AUTO_ASSIST_MAX=10
# Что готовить (регламент): по умолчанию суть, запросы, риски, шаги, черновик ответа
# AUTO_ASSIST_PROMPT_FILE=assist_prompt.md

# ======================= Участник бизнес-процессов =======================
# Агент выполняет задания БП, назначенные пользователю вебхука (docs/BP_PARTICIPANT.md)
BP_AGENT=false
BP_POLL_INTERVAL=60
# Какие решения агент принимает сам (остальные — человеку): approve, reject, ok, cancel
BP_AGENT_DECISIONS=approve,reject,ok,cancel
BP_MIN_CONFIDENCE=0.5
# ID сотрудника, которому передавать сложные случаи (сообщение от бота + делегирование)
BP_AGENT_ESCALATE_TO=
BP_MAX_PER_CYCLE=5
BP_TIMELINE_NOTE=true
# BP_AGENT_PROMPT_FILE=bp_rules.md

# ======================= Личные ассистенты (права сотрудника) =======================
# Описание ассистентов: personal_agents.toml (пример — personal_agents.example.toml, docs/RIGHTS_AND_AGENTS.md)
PERSONAL_AGENTS_FILE=personal_agents.toml
# Личный чат с ботом «ИИ-агент»: personal — личный ассистент, если он есть, иначе права агента;
# personal_only — только личный ассистент (без него отказ); service — всегда права агента
PRIVATE_CHAT_MODE=personal
PERSONAL_MEMORY_MAX=50
PERSONAL_HISTORY=40
# Вебхуки сотрудников (имена — из webhook_env в personal_agents.toml)
# PA_15_WEBHOOK=https://portal.company.ru/rest/15/xxxxxxxxxxxx/

# ======================= Поведение агента =======================
# false — режим только чтения
AGENT_ALLOW_WRITE=true
# ID пользователей через запятую, которым разрешено общаться с агентом (пусто — всем)
AGENT_ALLOWED_USERS=
AGENT_HISTORY=20
AGENT_MAX_STEPS=10
# Файл с дополнительными инструкциями (регламенты, тон, названия воронок)
# AGENT_PROMPT_FILE=prompt.md

# ======================= Инструменты и расширения =======================
# Отключить инструменты (через запятую), например: bp_start,crm_add
TOOLS_DISABLED=
# Плагины: импортируемые модули через запятую и/или каталог с *.py (см. docs/EXTENDING.md)
TOOL_PLUGINS=
PLUGINS_DIR=plugins
# Универсальный вызов REST (bitrix_call): off | read (только читающие методы) | full
BITRIX_CALL=read
# Явно разрешённые / дополнительно запрещённые методы (шаблоны fnmatch через запятую)
BITRIX_CALL_ALLOW=
BITRIX_CALL_DENY=

DATA_DIR=data
LOG_LEVEL=INFO
